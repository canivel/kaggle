{
  "shared": {
    "model_name": "gpt-5.4",
    "base_url": "https://api.openai.com/v1",
    "provider": "openai-responses",
    "context_window": 120000
  },
  "experiments": {
    "root_dir": "/sw/public/arc_3_results/{username}"
  },
  "environment": {
    "dataset": "",
    "include_tags": ["official"],
    "exclude_tags": [],
    "games": ["wa30-ee6fef47", "g50t-5849a774", "sc25-635fd71a", "ka59-38d34dbb", "m0r0-492f87ba"],
    "max_steps": null,
    "max_runtime_minutes": 240,
    "max_experiment_runtime_minutes": null,
    "max_experiment_runtime_hours": null,
    "n_passes": 2,
    "concurrent_jobs": 32
  },
  "deployment": {
    "target": "inline",
    "wait": false,
    "source_repos": ["../tufa-arc-agi-framework", "../re-arc-3"],
    "slurm": {
      "gpu": "B200",
      "gpu_count": 1,
      "time": "07:00:00",
      "image": "",
      "partition": "llm",
      "nodelist": "",
      "start_local_server": false,
      "extra_sbatch_flags": ["--account=llm", "--qos=llm"]
    }
  },
  "server": {
    "backend": "vllm",
    "host": "127.0.0.1",
    "port": 1234,
    "tensor_parallel_size": 1,
    "generation_config": "vllm",
    "language_model_only": false,
    "enable_prefix_caching": true,
    "tool_call_parser": "qwen3_coder",
    "reasoning_parser": "qwen3",
    "default_chat_template_kwargs": {
      "preserve_thinking": true
    }
  },
  "analyzer": {
    "app_name": "ARC3 Agent Harness",
    "max_output": 0,
    "thinking": true,
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "timeout": 300,
    "tool_steps": 0,
    "tool_timeout": 30,
    "tool_output_tokens": 1024,
    "save_request_logs": false
  },
  "chat": {
    "max_tokens": 2048,
    "temperature": 0.7,
    "top_p": 0.8,
    "top_k": 20,
    "thinking": true
  },
  "viewer": {
    "port": 8025
  },
  "multimodal": {
    "context": "current_grid",
    "upscale": 16
  }
}
