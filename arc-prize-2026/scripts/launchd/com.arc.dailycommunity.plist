<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS port of the Windows Scheduled Task "ARCCommunityBrief".
     06:00 headless Claude research sweep (research-only; writes the day's
     community brief). Consumed by com.arc.dailyiterate at 08:23. Idempotent per
     day-file.
     Times are LOCAL (machine TZ America/New_York, same as the Windows box). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.arc.dailycommunity</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/danilocanivel/Projects/kaggle/arc-prize-2026/scripts/daily_community.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/danilocanivel/Projects/kaggle/arc-prize-2026</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/danilocanivel/Projects/kaggle/arc-prize-2026/runs/launchd.dailycommunity.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/danilocanivel/Projects/kaggle/arc-prize-2026/runs/launchd.dailycommunity.err</string>

    <key>RunAtLoad</key>
    <false/>
    <key>LowPriorityIO</key>
    <false/>
</dict>
</plist>
