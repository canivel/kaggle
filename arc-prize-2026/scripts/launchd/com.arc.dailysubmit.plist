<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS port of the Windows Scheduled Task "ARCDailySubmit".
     Fires 18:37 and 20:07 LOCAL time (machine TZ is America/New_York, same as
     the Windows box, so the times port 1:1). The daemon is idempotent per UTC
     day: a double fire, or an overlap with the still-live Windows box, submits
     at most once. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.arc.dailysubmit</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/danilocanivel/Projects/kaggle/arc-prize-2026/scripts/run_daily_submit.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/danilocanivel/Projects/kaggle/arc-prize-2026</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>18</integer>
            <key>Minute</key><integer>37</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>7</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/danilocanivel/Projects/kaggle/arc-prize-2026/runs/launchd.dailysubmit.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/danilocanivel/Projects/kaggle/arc-prize-2026/runs/launchd.dailysubmit.err</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
